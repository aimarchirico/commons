{
  "name": "@aimarchirico/commons-ts",
  "version": "3.4.3",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "check": "eslint && tsc && vitest run",
    "fix": "eslint --fix",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "exports": {
    "./eslint-base": "./src/lib/eslint-base.ts",
    "./eslint-core": "./src/lib/eslint-core.ts",
    "./folders": "./src/lib/folders.ts",
    "./tsconfig-base": "./src/assets/tsconfig-base.json",
    "./tsconfig-build": "./src/assets/tsconfig-build.json",
    "./vitest-base": {
      "types": "./dist/lib/vitest-base.d.ts",
      "default": "./dist/lib/vitest-base.js"
    }
  },
  "dependencies": {
    "@es-joy/jsdoccomment": "^0.92.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsonc": "^3.3.0",
    "globals": "^17.9.0",
    "gts": "^7.0.0",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "eslint": "^9.39.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
