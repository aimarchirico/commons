{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "${configDir}/**/*.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/**/*.mts",
    "${configDir}/**/*.cts",
    "${configDir}/**/*.js",
    "${configDir}/**/*.jsx",
    "${configDir}/**/*.mjs",
    "${configDir}/**/*.cjs",
    "${configDir}/**/*.json"
  ],
  "exclude": ["${configDir}/**/dist/**", "${configDir}/**/coverage/**"]
}
